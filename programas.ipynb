def menu_principal():
    root = tk.Tk()
    root.title('STUDIO OM — Dashboard Oficina Multimédia')
    root.geometry('560x400')
    root.minsize(460, 350)
    root.configure(bg='#141A36')
    janelas = {}

    def abrir(nome, programa):
        janela = janelas.get(nome)
        if janela is not None and janela.winfo_exists():
            janela.deiconify()
            janela.lift()
            janela.focus_force()
            return
        janela = tk.Toplevel(root)
        janelas[nome] = janela
        programa(janela)

    tk.Label(root, text='STUDIO OM', bg='#141A36', fg='#FFA48F',
             font=('Arial', 25, 'bold')).pack(pady=(30, 6))
    tk.Label(root, text='Cria. Explora. Experimenta.', bg='#141A36',
             fg='white', font=('Arial', 15)).pack(pady=(0, 20))
    for nome, programa, cor in [
        ('01 — Nuvem de palavras', NuvemPalavras, '#FFB09B'),
        ('02 — Cores e formatos', CoresFormatos, '#A9E1E7'),
        ('03 — Jogo do número secreto', JogoNumeroSecreto, '#D6C5FF'),
    ]:
        tk.Button(root, text=nome, bg=cor, fg='#20253D',
                  font=('Arial', 13, 'bold'), pady=10,
                  command=lambda n=nome, p=programa: abrir(n, p)).pack(
                      fill='x', padx=45, pady=5)
    ttk.Button(root, text='Sair', command=root.destroy).pack(pady=14)
    root.mainloop()


if __name__ == '__main__':
    menu_principal()
